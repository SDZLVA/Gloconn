# Supabase — required for authentication and saved trips
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL used for OAuth redirects (set in Supabase Auth settings too)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API providers — mock data is used by default (no external API keys needed)
# Set to "false" when real providers are configured in lib/providers/registry
USE_MOCK_PROVIDERS=true
