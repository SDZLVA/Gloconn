# =============================================================================
# Glooconn environment configuration
# =============================================================================
# Copy this file to `.env.local` and fill in values for your machine.
# Never commit `.env.local` or real API keys to git.
#
# All variables are read by `lib/config/` — do not read process.env elsewhere.
# =============================================================================

# --- App (browser-safe) -------------------------------------------------------

# Public site URL for OAuth redirects — also set in Supabase Auth settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (browser-safe — anon key is designed for client use) ------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Provider selection -------------------------------------------------------
# Default: mock data — no external API keys required for local development.

USE_MOCK_PROVIDERS=true

# Per-domain provider when USE_MOCK_PROVIDERS=false:
# mock | google-maps | amadeus | booking | omio | serpapi (config ready — Sprint 9.2; adapter later)
DESTINATIONS_PROVIDER=mock
HOTELS_PROVIDER=mock
FLIGHTS_PROVIDER=mock
TRANSPORT_PROVIDER=mock

# --- Travel API keys (SERVER ONLY — never prefix with NEXT_PUBLIC_) -----------
# Leave empty while using mock providers. Required when matching provider is active.

# Google Maps / Places (destinations)
GOOGLE_MAPS_API_KEY=

# Amadeus (flights) — future production path (package frozen during SerpAPI work)
# AMADEUS_ENV selects a known host only: test | production (no arbitrary URLs)
AMADEUS_ENV=test
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# Optional timeouts (milliseconds). Defaults: OAuth 10000, fetch 15000.
# AMADEUS_OAUTH_TIMEOUT_MS=10000
# AMADEUS_FETCH_TIMEOUT_MS=15000

# SerpAPI Google Flights / Google Hotels (shared key)
# Example when enabling live hotels or flights:
#   USE_MOCK_PROVIDERS=false
#   FLIGHTS_PROVIDER=serpapi
#   HOTELS_PROVIDER=serpapi
SERPAPI_API_KEY=
SERPAPI_DEEP_SEARCH=false

# Booking.com (hotels)
BOOKING_API_KEY=

# Omio (buses and trains)
OMIO_API_KEY=
